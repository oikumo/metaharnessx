{
  "$schema": "https://opencode.ai/config.json",
  "lsp": true,

  "agent": {
    "build": {
      
    },
    "code-reviewer": {
      "tools": {
        "write": false,
        "edit": false
      }
    }
  },
  "permission": {
    "edit": "allow",
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny"
    },
    "bash": {
      "*": "ask",
      "uv *": "allow",
      "bun *": "allow",
      "npx *": "allow",
      "npm *": "allow",
      "ls *": "allow",
      "cat *": "allow",
      "git status *": "allow",
      "git log *": "allow",
      "git diff *": "allow",
      "git show *": "allow",
      "git stash *": "allow",
      "git add *": "allow",
      "git commit *": "allow",
      "grep *": "allow",
      "find *": "allow",
      "sort *": "allow",
      "head *": "allow",
      "echo *": "allow",
      "tail *": "allow",
      "sed *": "allow",
      "wc *": "allow",
      "rg *": "allow",
      "uniq *": "allow",
      "tr *": "allow",
      "awk *": "allow",
      "rm *": "allow",
      "true" : "allow",
      "nl *": "allow",
      "mv *": "allow",
      "stat *": "allow",
      "mkdir *": "allow",
      "rmdir *": "allow",
      "date *": "allow",
      "pwd *": "allow",
      "which *": "allow",
      "jq *": "allow",
      "sqlite3 *": "allow",
      "git worktree *": "allow",
      "git *": "allow",
      "time *": "allow",
      "xargs *": "allow",
      "git push *": "deny",
      "git pull *": "deny",
      "git fetch *": "deny",
      "git ls-remote *": "deny",
      "git remote *": "deny",
      "git clone *": "deny",
      "git submodule *": "deny",
      "python *": "deny",
      "python3 *": "deny",
      "pip *": "deny",
      "pip3 *": "deny",
      "pytest *": "deny",
      "python3 --version": "allow",
      "python3 scripts/mhx/*": "allow",
      "python3 scripts/mhx.py *": "allow",
      "python3 -m pytest *": "allow",
      "pytest tests/*": "allow",
      "uv run pytest *": "allow"
    },
    "grep *": "allow",
    "glob *": "allow",
    "list *": "allow",
    "lsp": "allow",
    "skill": "allow",
    "reason_check": "allow"
  }
}
